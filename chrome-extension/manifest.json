{
  "manifest_version": 3,
  "name": "Huellas Master — Puente Web Gratis (Gemini & Google Flow)",
  "version": "1.8.0",
  "description": "Conecta Huellas Master con las pestañas de Gemini Web y Google Flow abiertas en la misma ventana.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://flow.google.com/*",
    "https://*.flow.google.com/*",
    "https://labs.google/*",
    "https://*.googleusercontent.com/*",
    "https://*.googleapis.com/*",
    "https://*.gstatic.com/*",
    "https://*.google.com/*",
    "http://localhost:4200/*",
    "http://127.0.0.1:4200/*",
    "https://raydelw-a11y.github.io/*",
    "https://huellasdelahumanidad.com/*",
    "https://*.huellasdelahumanidad.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:4200/*",
        "http://127.0.0.1:4200/*",
        "https://raydelw-a11y.github.io/*",
        "https://huellasdelahumanidad.com/*",
        "https://*.huellasdelahumanidad.com/*"
      ],
      "js": ["huellas-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": ["gemini-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://*.flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": ["flow-content.js"],
      "run_at": "document_idle"
    }
  ]
}
