{
  "manifest_version": 3,
  "name": "Huellas Master — Puente Web Gratis (Gemini, ChatGPT, Copilot, Google Flow & Flow Music)",
  "version": "2.9.1",
  "description": "Conecta Huellas Master con Gemini Web, ChatGPT Web, Microsoft Copilot Web (MODO CINCO), Google Flow y Flow Music.",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://copilot.microsoft.com/*",
    "https://*.copilot.microsoft.com/*",
    "https://copilot.com/*",
    "https://*.copilot.com/*",
    "https://m365.cloud.microsoft/*",
    "https://copilot.cloud.microsoft/*",
    "https://*.cloud.microsoft/*",
    "https://flow.google.com/*",
    "https://*.flow.google.com/*",
    "https://labs.google/*",
    "https://flowmusic.app/*",
    "https://*.flowmusic.app/*",
    "https://producer.ai/*",
    "https://*.producer.ai/*",
    "https://storage.googleapis.com/*",
    "https://suno.com/*",
    "https://*.suno.com/*",
    "https://*.suno.ai/*",
    "https://*.googleusercontent.com/*",
    "https://*.googleapis.com/*",
    "http://localhost:4200/*",
    "http://127.0.0.1:4200/*",
    "https://*.onrender.com/*",
    "https://raydelw-a11y.github.io/*",
    "https://huellasdelahumanidad.com/*",
    "https://*.huellasdelahumanidad.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:4200/*",
        "http://127.0.0.1:4200/*",
        "https://*.onrender.com/*",
        "https://raydelw-a11y.github.io/*",
        "https://huellasdelahumanidad.com/*",
        "https://*.huellasdelahumanidad.com/*"
      ],
      "js": ["huellas-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": ["gemini-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["chatgpt-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://copilot.microsoft.com/*",
        "https://*.copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://*.copilot.com/*",
        "https://m365.cloud.microsoft/*",
        "https://copilot.cloud.microsoft/*",
        "https://*.cloud.microsoft/*"
      ],
      "js": ["copilot-content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://*.flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": ["flow-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flowmusic.app/*",
        "https://*.flowmusic.app/*",
        "https://producer.ai/*",
        "https://*.producer.ai/*",
        "https://suno.com/*",
        "https://*.suno.com/*"
      ],
      "js": ["suno-content.js"],
      "run_at": "document_idle"
    }
  ]
}
