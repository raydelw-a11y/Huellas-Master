{
  "manifest_version": 3,
  "name": "Huellas Master — Puente Web Gratis (Gemini & Google Flow)",
  "version": "1.2.0",
  "description": "Conecta Huellas Master con tus pestañas abiertas de Gemini Web y Google Flow usando tu cuota gratis.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://flow.google.com/*",
    "https://*.flow.google.com/*",
    "https://labs.google/*",
    "http://localhost:4200/*",
    "https://raydelw-a11y.github.io/*",
    "https://huellasdelahumanidad.com/*",
    "https://*.huellasdelahumanidad.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:4200/*",
        "https://raydelw-a11y.github.io/*",
        "https://huellasdelahumanidad.com/*",
        "https://*.huellasdelahumanidad.com/*"
      ],
      "js": ["huellas-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": ["gemini-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://*.flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": ["flow-content.js"],
      "run_at": "document_idle"
    }
  ]
}
